# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- LLM (required) ---------------------------------------------------------
# OpenRouter is OpenAI-compatible. Any chat model works; the free tier is fine
# but reasoning models are slower and can truncate long outputs, so the agent
# layer only ever asks for small, bounded JSON decisions.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Discovery / verification (strongly recommended) ------------------------
# Free tier: 1,000 credits/month. basic search = 1 credit, extract = 1 per 5 URLs.
TAVILY_API_KEY=tvly-...

# --- Optional legacy providers (not required) -------------------------------
# Only used if you explicitly enable the scraper source in the run plan.
SCRAPERAPI_API_KEY=
APIFY_API_TOKEN=

# --- Runtime tuning (all optional, sane defaults built in) -----------------
LEADS_HOME=var
LEADS_CONCURRENCY=4
LEADS_MAX_LLM_CALLS=500
LEADS_MAX_TAVILY_CREDITS=900
LEADS_HTTP_CACHE_TTL_HOURS=168
LEADS_LOG_LEVEL=INFO
